# Copy this file to .env and fill in real values. Never commit .env.
# Everything prefixed EXPO_PUBLIC_ is bundled into the client app and is
# NOT secret-safe -- only put values here that are safe for any app user
# to see (Supabase anon key is designed to be public; RLS protects data).

# --- Supabase (client) ---------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Used to build OAuth/deep-link redirect URLs (e.g. luvlots://auth/callback
# in dev, or your custom scheme / associated domain in production).
EXPO_PUBLIC_APP_URL=luvlots://

# --- Optional: error reporting (Sentry) ----------------------------------
# Leave blank to disable. See lib/observability.ts.
EXPO_PUBLIC_SENTRY_DSN=

# --- Payments (G8 Pay / Ganap) --------------------------------------------
# Set to "true" only once the g8-pay-* Supabase Edge Functions have real
# secrets configured (see below). Until then this stays "false" and
# checkout will show a clear "payments not yet configured" error instead of
# a fake success screen.
EXPO_PUBLIC_ENABLE_G8_PAY=false

# ===========================================================================
# Everything below is SERVER-SIDE ONLY -- set these as Supabase Edge
# Function secrets (`supabase secrets set NAME=value`), never in this app's
# .env / EXPO_PUBLIC_* vars, and never commit real values anywhere.
# ===========================================================================

# SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY are
# injected automatically into every Edge Function by Supabase -- you do not
# need to set them yourself.

# G8 Pay / Ganap merchant credentials (from your Ganap project's "Settings"
# tab -- Project UUID and Secret Key). Optional: G8PAY_BASE_URL defaults to
# https://api.ganap.net if unset. See supabase/functions/_shared/g8pay-adapter.ts.
G8PAY_BASE_URL=https://api.ganap.net
G8PAY_MERCHANT_PROJECT_ID=
G8PAY_SECRET_KEY=

# --- Optional: push notifications (Firebase Cloud Messaging) -------------
# Deferred for now -- no code depends on these yet. Fill in when FCM is
# wired up (see notifications table + README "Future work").
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
